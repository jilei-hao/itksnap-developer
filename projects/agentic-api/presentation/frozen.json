    "sections": [
     [
      "Future directions",
      {
       "items": [
        {
         "lead": "Route cases by confidence.",
         "text": "Let agreement between model runs decide which cases a person sees."
        },
        {
         "lead": "Train models with the audit records.",
         "text": "Each correction is a labeled example of where the model fails."
        },
        {
         "lead": "Automate the improvement loop.",
         "text": "Retrain, test, and update the server without manual steps. The records then show whether corrections drop."
        }
       ],
